  "timeline": [
    {
      "round": 1,
      "phase": "start",
      "kind": "message",
      "text": "Cao Cao's ships lie chained bow to stern from bank to bank, a floating road a hundred decks long. The wind is out of the north-west and every spark would fly back at us."
    },
    {
      "round": 4,
      "phase": "end",
      "kind": "message",
      "text": "Zhou Yu's pickets report the pennants on the flagship sagging. Toward the fifth watch the air goes still, then stirs from the south-east."
    },
    {
      "round": 5,
      "phase": "start",
      "kind": "message",
      "text": "The south-east wind has come, a true gale, and it is blowing straight up the river into the fleet. Huang Gai's fire ships slip their moorings."
    },
    {
      "round": 10,
      "phase": "start",
      "kind": "message",
      "text": "Whatever has not burned is cut loose or sunk. The river is full of drifting spars and smoke."
    }
  ],
